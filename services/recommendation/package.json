{
  "name": "@aluevaaka/recommendation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build && node scripts/bundle.mjs",
    "build:tsc": "tsc --build",
    "clean": "rm -rf dist bundle *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@aluevaaka/data-model": "workspace:*",
    "@aluevaaka/schemas": "workspace:*",
    "@aluevaaka/scoring": "workspace:*",
    "@aws-sdk/client-cloudwatch": "^3.1102.0",
    "@aws-sdk/client-s3": "^3.1102.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "*",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "typescript": "*",
    "vitest": "^4.1.10"
  }
}
